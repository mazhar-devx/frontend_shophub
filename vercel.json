{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://backend-shophub.vercel.app/api/v1/sitemap.xml" },
    { "source": "/product/:id", "destination": "https://backend-shophub.vercel.app/api/v1/seo?type=product&id=:id" },
    { "source": "/watch-me", "destination": "https://backend-shophub.vercel.app/api/v1/seo?type=video" },
    { "source": "/blog/:slug", "destination": "https://backend-shophub.vercel.app/api/v1/seo?type=blog&slug=:slug" },
    { "source": "/creator/:id", "destination": "https://backend-shophub.vercel.app/api/v1/seo?type=creator&id=:id" },
    { "source": "/((?!assets/|favicon.ico|sw.js|manifest.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
